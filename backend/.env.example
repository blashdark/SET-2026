# Copy to .env and run: node --env-file=.env src/index.js

# --- Server ---
PORT=3000
BASE_URL=http://localhost:3000
DATA_DIR=

# --- Access token (HMAC) ---
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL=3600

# --- Email verification ---
# Lifetime of the verification link (seconds). Default 24h.
VERIFY_TTL_SECONDS=86400

# --- SMTP (Gmail) ---
# Gmail requires an App Password (enable 2FA first). Leave blank to run in
# dev mode: the verification link is logged to the console instead of emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=you@gmail.com
